    1: "Jan",
    2: "Feb",
    3: "Mar",
    4: "Apr",
    5: "May",
    6: "Jun",
    7: "Jul",
    8: "Aug",
    9: "Sep",
    10: "Oct",
    11: "Nov",
    12: "Dec",
}


def date_sort_key(notification: Notification) -> tuple[int, int, int, int, int, int]:
    match = re.search(
        r"(\d{1,2})\s+([A-Za-z]+)\s+(\d{4})\s+at\s+(\d{1,2}):(\d{2}):(\d{2})",
        notification.date_received,
    )
    if not match:
        return (0, 0, 0, 0, 0, 0)
    day, month_name, year, hour, minute, second = match.groups()
    return (int(year), MONTHS.get(month_name.lower(), 0), int(day), int(hour), int(minute), int(second))


def sorted_group_values(groups: OrderedDict[tuple[str, str, str, str], list[Notification]]) -> list[list[Notification]]:
    return sorted(groups.values(), key=lambda group: max(date_sort_key(notification) for notification in group), reverse=True)


def unique_notifications(group: Sequence[Notification], terms: Sequence[str]) -> list[Notification]:
    unique: list[Notification] = []
    seen: set[tuple[str, str, str]] = set()
    for notification in sorted(group, key=date_sort_key):
        key = (received_stamp(notification.date_received), sender_display(notification.sender), describe(notification, terms))
        if key in seen:
            continue
        seen.add(key)
        unique.append(notification)
    return unique


def received_stamp(date_received: str) -> str:
    match = re.search(
        r"(\d{1,2})\s+([A-Za-z]+)\s+\d{4}\s+at\s+(\d{1,2}:\d{2})",
        date_received,
    )
    if not match:
        return date_received
    day, month_name, time = match.groups()
    month = MONTH_ABBR.get(MONTHS.get(month_name.lower(), 0), month_name[:3])
    return f"{month} {int(day):02d} {time}"


def event_parts(notification: Notification, terms: Sequence[str]) -> tuple[str, str, str]:
    description = describe(notification, terms)
    if description.startswith("for me:"):
        return (style("★", "1", "33"), style("FOR ME".ljust(8), "1", "33"), yellow(description.removeprefix("for me: ")))
    if description.startswith("merged "):
        return (green("✓"), green("MERGED".ljust(8)), green(description.removeprefix("merged ")))
    if description.startswith("approved by "):
        return (green("✓"), green("APPROVED".ljust(8)), description.removeprefix("approved by "))
    if description.startswith("resolved "):
        return (green("✓"), green("RESOLVED".ljust(8)), description.removeprefix("resolved "))
    if description.startswith("pushed "):
        return (blue("↑"), blue("PUSH".ljust(8)), description.removeprefix("pushed "))
    if "discussion" in description:
        return (magenta("●"), magenta("DISCUSS".ljust(8)), f"{cyan(sender_display(notification.sender))}: {description}")
    if description.startswith("comment:"):
        return (cyan("●"), cyan("COMMENT".ljust(8)), f"{cyan(sender_display(notification.sender))}: {description.removeprefix('comment:').strip()}")
    return (gray("•"), gray("UPDATE".ljust(8)), f"{cyan(sender_display(notification.sender))}: {description}")


def print_event(notification: Notification, terms: Sequence[str]) -> None:
    icon, tag, text = event_parts(notification, terms)
    time = gray(received_stamp(notification.date_received).rjust(12))
    print(f"   {icon} {time} {tag} {text}")


def print_summary(groups: Sequence[Sequence[Notification]], terms: Sequence[str]) -> None:
    unread_total = sum(1 for group in groups for notification in group if not notification.read)
    print(bold(cyan(f"{len(groups)} MR thread(s) · {unread_total} unread notification(s)")))
    for index, group in enumerate(groups, start=1):
        first = group[0]
        events = unique_notifications(group, terms)
        unread_count = sum(1 for notification in group if not notification.read)
        unread = yellow(bold(f"{unread_count} unread")) if unread_count else gray("read")
        count = gray(f"{len(group)} notification(s)")
        label = bold(cyan(first.label))
        title = bold(subject_title(first.subject))
        path = gray(first.project_path)
        print()
        print(f"{gray(str(index).rjust(2) + '.')} {label} {gray('·')} {title}")
        print(f"    {path} {gray('·')} {count} {gray('·')} {unread}")
        for notification in events:
            print_event(notification, terms)


def summary_key(url: str) -> str:
    parsed = urlsplit(url)
    path = re.sub(r"(/-/merge_requests/[1-9][0-9]*)(?:/.*)?$", r"\1", parsed.path.rstrip("/"))
    return urlunsplit((parsed.scheme, parsed.netloc, path, "", ""))


def watch_summaries(threads: Sequence[MRThread], issue_urls: dict[str, str], terms: Sequence[str], status: str) -> None:
    summaries: dict[str, list[list[Notification]]] = {}
    for thread in threads:
        urls = [thread.notifications[0].url, *(issue_urls[issue] for issue in thread.context.issues)]
        for url in urls:
            summaries.setdefault(summary_key(url), []).append(thread.notifications)
    interactive = sys.stdout.isatty()
    previous: str | None = None
    try:
        if interactive:
            print("\033[?1049h", end="", flush=True)
        while True:
            url = run_osascript(CURRENT_TAB_SCRIPT, [])
            key = summary_key(url)
            if key != previous:
                if interactive:
                    print("\033[2J\033[H", end="")
                print(bold(cyan(status)))
                print(dim("Following Safari's selected tab · Ctrl-C to exit" if interactive else "Selected Safari tab"))
                groups = summaries.get(key)
                if groups:
                    print()
                    print_summary(groups, terms)
                else:
                    print("\nSelect a review tab in Safari to see its summary.")
                sys.stdout.flush()
                previous = key
            if not interactive or not url:
                return
            time.sleep(0.5)
    except KeyboardInterrupt:
        pass
    finally:
        if interactive:
            print("\033[?1049l", end="", flush=True)


def notify_ready(status: str, failed: bool) -> None:
    title = "MR review needs attention" if failed else "MR tabs ready"
    try:
        run_osascript(NOTIFY_SCRIPT, [status, title])
    except (OSError, RuntimeError) as exception:
        print(f"Warning: could not send the ready notification: {exception}", file=sys.stderr)


def options() -> tuple[bool, bool]:
    args = sys.argv[1:]
    if any(arg not in {"--dry-run", "--keep-mail"} for arg in args):
        print("Usage: open-mail-mrs [--dry-run] [--keep-mail]", file=sys.stderr)
        raise SystemExit(2)
    return "--dry-run" in args, "--keep-mail" in args


def main() -> int:
    dry_run, keep_mail = options()
    try:
        message_count, notifications = read_notifications()
        groups = group_notifications(notifications)
        if not groups:
            print(f"No GitLab merge request notifications found in {message_count} Mail message(s).", file=sys.stderr)
            return 2
        terms = me_terms()
        ordered_groups = sorted_group_values(groups)
        with ThreadPoolExecutor(max_workers=min(8, len(ordered_groups))) as executor:
            contexts = list(executor.map(mr_context, ordered_groups))
        users: dict[str, dict[str, object] | None] = {}
        windows: dict[str, list[MRThread]] = {}
        for group, context in zip(ordered_groups, contexts, strict=True):
            reason = skip_group(group, context, users)
            if reason:
                print(f"Skipping {group[0].label}: {reason}.")
                continue
            user = gitlab_user(group[0].host, users)
            assigned = user is not None and user["id"] in context.assignee_ids
            window = "Assigned to me" if assigned else "Other MRs"
            windows.setdefault(window, []).append(MRThread(group, context))
        issues = list(dict.fromkeys(issue for threads in windows.values() for thread in threads for issue in thread.context.issues))
        issue_urls = {} if dry_run else dict(zip(issues, jira_urls(issues), strict=True))
        loading_errors: list[str] = []
        for window, threads in windows.items():
            urls: list[str] = []
            for task_threads in group_by_jira(threads).values():
                for thread in task_threads:
                    first = thread.notifications[0]
                    urls.extend((first.url, first.diff_url))
                    urls.extend(issue_urls[key] for key in thread.context.issues if key in issue_urls)
            urls = list(dict.fromkeys(urls))
            if dry_run:
                print(f"\n{yellow(bold('DRY RUN'))} Would open MR, diff, and Jira pages for {len(threads)} MR(s), grouped by Jira task, in a new Safari window: {window}.")
            elif urls:
                print(f"\n{bold(cyan(f'Opening {len(urls)} pages in a new Safari window: {window}; waiting for page and diff content…'))}", flush=True)
                try:
                    run_osascript(OPEN_SCRIPT, urls)
                except RuntimeError as exception:
                    loading_errors.append(f"{window}: {exception}")
        if loading_errors:
            print("\n".join(loading_errors), file=sys.stderr)
        if dry_run:
            print("\nWould wait up to 15 minutes per window for page and diff content to load.")
            print("Would leave mail notifications unchanged (--keep-mail)." if keep_mail else "Would mark unread notifications read and move all matching notifications to Trash.")
        elif loading_errors or keep_mail:
            print("Mail notifications left unchanged (--keep-mail)." if keep_mail else "Loading failed; mail notifications left unchanged.")
        else:
            marked_total, moved_total = cleanup_notifications(notifications)
            print(green(f"Marked {marked_total} notification(s) read; moved {moved_total} notification(s) to Trash."))
        if not dry_run and windows:
            status = "Review tabs opened; some pages failed to load. Mail kept." if loading_errors else "Review tabs are open and ready."
            notify_ready(status, bool(loading_errors))
            watch_summaries([thread for threads in windows.values() for thread in threads], issue_urls, terms, status)
        return int(bool(loading_errors))
    except Exception as exception:
        print(f"open-mail-mrs: {exception}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
