CLEANUP_SCRIPT = MAILBOX_SCRIPT + r'''
on run argv
    set targetAccountId to item 1 of argv
    set targetMessageIds to items 2 thru -1 of argv

    tell application "Mail"
        set messageList to my gitlabMessages(targetAccountId)
        set targetTrash to missing value
        repeat with trashFolder in mailboxes of trash mailbox
            if (id of account of trashFolder) is targetAccountId then
