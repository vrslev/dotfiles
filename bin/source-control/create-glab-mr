#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: create-glab-mr [--no-web] [--draft] [--use-last-commit-msg | TITLE]

Create a GitLab merge request.

Arguments:
  TITLE                  Use TITLE as the merge request title
  --no-web               Create directly without opening the browser
  --draft                Mark the merge request as draft
  --use-last-commit-msg  Use the last commit subject as the merge request title
  -h, --help             Show this help

Without TITLE, create-glab-mr uses gen-mr-title.
Issue prefix is added from the current branch when present.
EOF
}

open_in_browser=true
draft=false
title_mode="generated"
title_arg=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        --no-web)
            open_in_browser=false
            ;;
        --draft)
            draft=true
            ;;
        --use-last-commit-msg)
            if [ "$title_mode" != "generated" ]; then
                echo "create-glab-mr: specify only one title source" >&2
                exit 2
            fi
            title_mode="last-commit"
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        --*)
            echo "create-glab-mr: unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
        *)
            if [ "$title_mode" != "generated" ]; then
                echo "create-glab-mr: specify only one title source" >&2
                exit 2
            fi
            title_mode="explicit"
            title_arg="$1"
            ;;
    esac
    shift
done

if [ -n "$(git status --porcelain)" ]; then
    cai
fi

branch_name="$(git branch --show-current)"
work_issue_no="$(get-work-issue-no "$branch_name")"

title=""
case "$title_mode" in
    last-commit)
        title="$(git log -1 --pretty=%B | head -1)"
        ;;
    explicit)
        title="$title_arg"
        ;;
    generated)
        title="$(gen-mr-title)"
        ;;
esac

mr_title="$title"
if [ -n "$work_issue_no" ]; then
    mr_title="$work_issue_no: $title"
fi

glab_args=(mr create --squash-before-merge --remove-source-branch --push)
if [ "$open_in_browser" = true ]; then
    glab_args+=(--web)
else
    glab_args+=(--yes)
fi
if [ "$draft" = true ]; then
    glab_args+=(--draft)
fi

glab "${glab_args[@]}" \
    --description "" \
    --assignee "$(whoami)" \
    --title "$mr_title"
