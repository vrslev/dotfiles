#!/usr/bin/env -S uv run --python 3.14 --script
# pyright: strict
import os
import re
import subprocess
import sys
from typing import Final

from codex_generator import generate_with_codex

DEFAULT_MODEL: Final = "gpt-5.6-luna"
TITLE_PROMPT: Final = (
    "Generate one concise, descriptive merge request title.\n"
    "Success means:\n"
    "- the first character is a letter\n"
    "- the title is no more than 50 characters\n"
    "- it describes the overall theme rather than individual commits\n"
    "- it considers the Jira issue when one is supplied\n"
    "- it does not use template words such as adjust\n"
    "Return only the title, without quotes, Markdown, a prefix, or a trailing period.\n"
    "Use only the supplied context. Do not inspect files or use tools."
)


def log(content: str) -> None:
    print(f"gen-mr-title: {content}", file=sys.stderr)


def clean_title(raw_output: str) -> str:
    output_lines = [line.strip() for line in raw_output.splitlines() if not line.strip().startswith("```")]
    while output_lines and not output_lines[0]:
        output_lines.pop(0)
    if not output_lines:
        return ""

    title = re.sub(r"(?i)^(merge request|mr) title\s*:\s*", "", output_lines[0])
    title = re.sub(r"^[-*•]\s+", "", title)
    title = re.sub(r"\s+", " ", title.strip("`'\" ")).rstrip(".")
    return title


def generate_title(
    context: str,
    *,
    model: str,
    reasoning_effort: str,
    timeout_seconds: float,
) -> str:
    raw_title = generate_with_codex(
        TITLE_PROMPT,
        context,
        model=model,
        reasoning_effort=reasoning_effort,
        timeout_seconds=timeout_seconds,
    )
    title = clean_title(raw_title)
    if re.match(r"^[A-Za-z]", title) is None:
        raise RuntimeError(f"MR title must start with a letter: {title!r}")
    if len(title) > 50:
        raise RuntimeError(f"MR title must be at most 50 characters: {title!r}")
    return title


def get_default_branch() -> str:
    """Get the default branch name, trying different common names"""
    # Try to get the default branch from remote
    result = subprocess.run(
        ["git", "symbolic-ref", "refs/remotes/origin/HEAD"],
        capture_output=True,
        text=True,
    )
    if result.returncode == 0:
        return result.stdout.strip().split("/")[-1]

    # Fallback to common names
    for branch in ["main", "master"]:
        result = subprocess.run(
            ["git", "rev-parse", "--verify", branch],
            capture_output=True,
            text=True,
        )
        if result.returncode == 0:
            return branch

    # If we can't determine, default to 'main'
    return "main"


def parse_branch_name(ref: str) -> str:
    """Extract branch name from Git ref (e.g., refs/heads/main -> main, origin/main -> main)"""
    # Handle refs/heads/branch_name
    if ref.startswith("refs/heads/"):
        return ref[len("refs/heads/"):]
    
    # Handle origin/branch_name or other remote/branch_name formats
    if "/" in ref and not ref.startswith("refs/"):
        parts = ref.split("/")
        # If it looks like remote/branch, return branch part
        # But be careful not to cut off legitimate branch names with slashes
        if len(parts) >= 2 and parts[0] in ("origin", "upstream"):
            return "/".join(parts[1:])
        
    # For all other cases, return as is
    return ref


def main() -> None:
    try:
        # Get branch name for context
        branch_name = subprocess.run(
            ["git", "branch", "--show-current"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()

        # Get the configured merge target branch for this branch (base branch for MR)
        result = subprocess.run(
            ["git", "config", f"branch.{branch_name}.merge"],
            capture_output=True,
            text=True,
        )
        if result.returncode == 0 and result.stdout.strip():
            # Format is 'refs/heads/main' → extract branch name properly
            target_branch = parse_branch_name(result.stdout.strip())
        else:
            # Fallback: use upstream branch if set
            result = subprocess.run(
                ["git", "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}"],
                capture_output=True,
                text=True,
            )
            if result.returncode == 0:
                target_branch = parse_branch_name(result.stdout.strip())
            else:
                # Final fallback: default branch
                target_branch = get_default_branch()

        if target_branch == branch_name:
            target_branch = get_default_branch()

        # Find the common ancestor (merge base) between current branch and target branch
        merge_base = subprocess.run(
            ["git", "merge-base", branch_name, target_branch],
            capture_output=True,
            text=True,
        )
        if merge_base.returncode != 0:
            log(f"failed to find merge base between '{branch_name}' and '{target_branch}'")
            sys.exit(1)

        merge_base_hash = merge_base.stdout.strip()

        # Get full diff of changes in current branch relative to base
        diff = subprocess.run(
            ["git", "diff", f"{merge_base_hash}..HEAD"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()

        # If no diff, exit early
        if not diff:
            log("no changes detected between base and current branch")
            sys.exit(1)

        # Use the full diff as context instead of commit messages
        diff_text = diff

        # No need to split or count commits — we're using the full diff
        log(f"found {len(diff_text.splitlines())} lines of changes in this branch")

        # Extract issue number from branch name
        issue_result = subprocess.run(
            ["get-work-issue-no", branch_name],
            capture_output=True,
            text=True,
        )
        issue_number = issue_result.stdout.strip()

        jira_context = ""
        if issue_number:
            log(f"found issue number: {issue_number}")
            # Get Jira issue details
            jira_result = subprocess.run(
                [
                    "jira",
                    "issue",
                    "view",
                    issue_number,
                    "--plain",
                    "--comments",
                    "1000",
                ],
                capture_output=True,
                text=True,
            )
            if jira_result.returncode == 0:
                jira_context = (
                    f"\n\n# Jira Issue: {issue_number}\n{jira_result.stdout.strip()}"
                )
                log(f"added Jira issue context for {issue_number}")
            else:
                log(
                    f"failed to get Jira issue details for {issue_number}: {jira_result.stderr}"
                )

        model = os.environ.get(
            "CODEX_MR_TITLE_MODEL",
            os.environ.get("CODEX_GENERATOR_MODEL", DEFAULT_MODEL),
        )
        reasoning_effort = os.environ.get(
            "CODEX_MR_TITLE_THINKING",
            os.environ.get("CODEX_GENERATOR_THINKING", "low"),
        )
        timeout_seconds = float(
            os.environ.get(
                "CODEX_MR_TITLE_TIMEOUT",
                os.environ.get("CODEX_GENERATOR_TIMEOUT", "60"),
            )
        )
        title = generate_title(
            f"# Branch name: {branch_name}{jira_context}\n\n# Changes in this branch:\n{diff_text}",
            model=model,
            reasoning_effort=reasoning_effort,
            timeout_seconds=timeout_seconds,
        )
        sys.stdout.write(title)

    except Exception as exception:
        log(f"failed to generate MR title: {exception}")
        sys.exit(1)


if __name__ == "__main__":
    main()
