#!/usr/bin/env bash

set -euo pipefail

max_attempts=3
delay_seconds=1

usage() {
    cat <<'EOF'
Usage: retry [OPTIONS] [--] command [args...]

Retry a command until it succeeds or the attempt limit is reached.

Options:
  --attempts NUM   Total attempts (default: 3)
  --delay SECONDS  Delay between attempts (default: 1)
  -h, --help       Show this help
EOF
}

fail() {
    echo "retry: $1" >&2
    echo >&2
    usage >&2
    exit 2
}

while [[ $# -gt 0 ]]; do
    case $1 in
        --attempts)
            [[ $# -ge 2 ]] || fail "--attempts requires a value"
            max_attempts=$2
            shift 2
            ;;
        --delay)
            [[ $# -ge 2 ]] || fail "--delay requires a value"
            delay_seconds=$2
            shift 2
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            fail "unknown option: $1"
            ;;
        *)
            break
            ;;
    esac
done

[[ $max_attempts =~ ^[1-9][0-9]*$ ]] ||
    fail "--attempts must be a positive integer"
[[ $delay_seconds =~ ^[0-9]+([.][0-9]+)?$ ]] ||
    fail "--delay must be a non-negative number"
[[ $# -gt 0 ]] || fail "missing command"

exit_code=0
for ((attempt = 1; attempt <= max_attempts; attempt++)); do
    echo "Attempt $attempt/$max_attempts: $*" >&2
    if "$@"; then
        exit 0
    else
        exit_code=$?
    fi

    if ((attempt < max_attempts)); then
        echo "Command failed with exit code $exit_code. Retrying in $delay_seconds seconds..." >&2
        sleep "$delay_seconds"
    fi
done

echo "Command failed after $max_attempts attempts." >&2
exit "$exit_code"
